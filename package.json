{
  "name": "gantry",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "bun run registry:build && tsr generate && tsc --noEmit && vite build",
    "registry:build": "shadcn build",
    "typecheck": "tsr generate && tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "check": "bun run lint && bun run typecheck"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-router": "^1.170.33",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@tanstack/router-cli": "^1.167.34",
    "@tanstack/router-plugin": "^1.168.36",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "typescript": "~6",
    "vite": "^8"
  },
  "packageManager": "bun@1.4.2"
}
