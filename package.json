{
  "name": "gantry",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run docs:build && vite --port 3000",
    "build": "bun run registry:build && bun run docs:build && tsr generate && tsc --noEmit && vite build",
    "registry:build": "shadcn build",
    "docs:build": "bun scripts/build-docs.ts",
    "typecheck": "tsr generate && tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "check": "bun run lint && bun run typecheck"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tanstack/react-router": "^1.170.33",
    "@untitledui/icons": "^0.0.23",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.14.2",
    "recharts": "3.8.0",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/vite": "^4",
    "@tanstack/router-cli": "^1.167.34",
    "@tanstack/router-plugin": "^1.168.36",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6",
    "vite": "^8"
  },
  "packageManager": "bun@1.4.2"
}
